{
  "name": "meshchat-desktop",
  "version": "1.0.0",
  "description": "MeshChat desktop client",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.meshchat.desktop",
    "productName": "MeshChat",
    "files": ["main.js"],
    "win": { "target": "nsis" },
    "publish": [
      { "provider": "github", "owner": "Xiaomi2009user", "repo": "meshchat-desktop" }
    ]
  }
}
